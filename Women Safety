      <div class="side-label">YOUR SPACE</div>
      <nav aria-label="Main navigation">
        <a class="nav-item active" href="#home"><span class="nav-icon">⌂</span> Home</a>
        <a class="nav-item" href="#journey"><span class="nav-icon">↗</span> Plan a journey</a>
        <a class="nav-item" href="#signals"><span class="nav-icon">◉</span> Community signals <span class="nav-count">3</span></a>
        <a class="nav-item" href="#trusted"><span class="nav-icon">♡</span> Trusted circle</a>
      </nav>
      <div class="sidebar-bottom">
        <div class="privacy-card"><span class="privacy-icon">✳</span><div><b>Your privacy comes first</b><p>Your location is only shared when you choose to share it.</p><a href="#privacy">How we protect you <span>→</span></a></div></div>
        <button class="profile-button"><span class="avatar">A</span><span class="profile-copy"><b>Ananya</b><small>Personal space</small></span><span class="more">···</span></button>
      </div>
